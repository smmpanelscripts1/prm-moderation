{
    "name": "prm/moderation",
    "description": "Staff moderator panel with reports, warnings, content removal, and bans.",
    "type": "flarum-extension",
    "version": "2.0.0",
    "license": "MIT",
    "require": {
        "flarum/core": "^2.0.0-rc.8"
    },
    "autoload": {
        "psr-4": {
            "Prm\\Moderation\\": "src/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Moderator Panel",
            "category": "feature",
            "icon": {
                "name": "fas fa-shield-alt",
                "backgroundColor": "#8e2a2a",
                "color": "#fff"
            }
        },
        "flarum-cli": {
            "modules": {
                "admin": true,
                "forum": true,
                "js": true,
                "jsCommon": false,
                "css": true,
                "locale": true,
                "gitConf": false,
                "githubActions": false,
                "prettier": false,
                "typescript": false,
                "bundlewatch": false,
                "backendTesting": false,
                "editorConfig": false,
                "styleci": false
            }
        }
    },
    "minimum-stability": "beta",
    "prefer-stable": true
}
